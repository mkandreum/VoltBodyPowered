// Prisma Schema for VoltBody Powered

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  password      String
  name          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  profile       UserProfile?
  workoutLogs   WorkoutLog[]
  progressPhotos ProgressPhoto[]
  weightLogs    WeightLog[]
  dailyMetrics  DailyMetric[]
  mealLogs      MealLog[]
  weeklyGoals   WeeklyGoalState[]
  achievements  UserAchievement[]
  customExercises CustomExercise[]
  recoveryLogs  RecoveryLog[]
}

model UserProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  age           Int?
  weight        Float?
  height        Float?
  gender        String?
  goal          String?
  goalDirection String?
  goalTargetKg  Float?
  goalTimelineMonths Int?
  currentState  String?
  schedule      String?
  trainingDaysPerWeek Int?
  sessionMinutes Int?
  workHours     String?
  theme         String?
  motivationPhrase String?
  motivationPhoto String?
  
  mealTimes     Json?    // {breakfast, brunch, lunch, snack, dinner}
  foodPreferences Json?  // {vegetables, carbs, proteins}
  weeklySpecialSession Json? // {enabled, activity, day, durationMinutes}
  specialDish   Json?    // {ingredients, targetCalories}
  avatarConfig  Json?    // {muscleMass, bodyFat}
  
  routine       Json?    // WorkoutDay[]
  diet          Json?    // DietPlan
  insights      Json?    // Insights
  
  profilePhoto  String?
  notificationsEnabled Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WorkoutLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date        DateTime
  exerciseId  String
  weight      Float
  reps        Int
  duration    Int?
  rpe         Int?
  rir         Int?

  createdAt   DateTime @default(now())
  
  @@index([userId, date])
}

model ProgressPhoto {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date      DateTime
  url       String
  
  createdAt DateTime @default(now())
  
  @@index([userId, date])
}

model WeightLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date      DateTime
  weight    Float
  
  createdAt DateTime @default(now())
  
  @@unique([userId, date])
  @@index([userId, date])
}

model DailyMetric {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date       String
  steps      Int?
  distanceKm Float?
  activeKcal Float?
  totalKcal  Float?
  sleepHours Float?
  hrv        Float?
  restingHr  Int?
  avgHr      Int?
  waterMl    Int?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model MealLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date      String
  mealId    String

  createdAt DateTime @default(now())

  @@unique([userId, date, mealId])
  @@index([userId, date])
}

model WeeklyGoalState {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  weekStart String
  goalId    String
  label     String
  done      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart, goalId])
  @@index([userId, weekStart])
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  achievementId String
  unlockedAt    DateTime @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

model CustomExercise {
  id         String @id @default(uuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exerciseId String
  data       Json
  position   Int    @default(0)

  @@unique([userId, exerciseId])
  @@index([userId, position])
}

model RecoveryLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date       String
  sleepHours Float
  hrv        Float?
  score      Int

  createdAt  DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}
